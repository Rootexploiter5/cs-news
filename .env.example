# ==============================================================================
# Sentinel AI - Autonomous Threat Intelligence Platform Environment Config
# ==============================================================================

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass_2026
POSTGRES_DB=sentinel_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinel:sentinel_secure_pass_2026@db:5432/sentinel_db

# Local Host Database URL (Used when running web/worker directly on host without Docker)
HOST_DATABASE_URL=postgresql://sentinel:sentinel_secure_pass_2026@localhost:5432/sentinel_db

# AI / LLM Configuration
# Supports Google Gemini API (gemini-1.5-flash / gemini-2.0-flash / text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Ingestion Worker Settings
POLL_INTERVAL_SECONDS=900
SEVERITY_ALERT_THRESHOLD=8

# Discord Webhook for Critical Real-time Threat Alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Web Application Port
WEB_PORT=3000
